# ─────────────────────────────────────────
# AQI Prediction Project – Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────

# ── API Keys ──────────────────────────────
# AQICN World Air Quality Index API key
# Get one at: https://aqicn.org/api/
AQICN_KEY=your_aqicn_api_key_here

# OpenWeatherMap API key (used for historical data via Air Pollution History API)
# Get one at: https://openweathermap.org/api/air-pollution
OPENWEATHER_KEY=your_openweather_api_key_here

# ── Hopsworks Feature Store ───────────────
# Hopsworks API key – generate in Hopsworks UI under Account → API Keys
HOPSWORKS_KEY=your_hopsworks_api_key_here

# Hopsworks project name (must already exist in your Hopsworks account)
HOPSWORKS_PROJECT=aqi_faisalabad

# Hopsworks host (Serverless: c.app.hopsworks.ai, self-hosted: your domain)
HOPSWORKS_HOST=c.app.hopsworks.ai

# ── City Configuration ────────────────────
# Default city for data collection
DEFAULT_CITY=Faisalabad

# Latitude / Longitude of the city (used for OpenWeather + AQICN geo query)
CITY_LAT=31.4504
CITY_LON=73.1350

# ── MLflow Model Registry ─────────────────
# Set to "local" to use ./mlruns (no server needed) or a remote URI
MLFLOW_TRACKING_URI=./mlruns

# Experiment name inside MLflow
MLFLOW_EXPERIMENT=aqi_forecasting

# ── Notifications ─────────────────────────
# Slack webhook URL for failure alerts from GitHub Actions
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email address to receive failure alerts (requires SMTP config in GitHub Actions)
ALERT_EMAIL=your_email@example.com

# ── Pipeline Settings ─────────────────────
# How many hours of lookback to use as LSTM sequence length
MODEL_LOOKBACK_HOURS=24

# Number of days to forecast ahead
FORECAST_DAYS=3

# Random seed for reproducibility
RANDOM_SEED=42
